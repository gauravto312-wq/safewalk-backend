# SafeWalk V1 - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT REAL CREDS/KEYS TO SOURCE CONTROL!

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=safewalk_db
DB_USERNAME=root
DB_PASSWORD=safewalk_db_password_change_in_prod
MYSQL_ROOT_PASSWORD=safewalk_db_password_change_in_prod

# Redis Cache & GEO Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Messaging Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SOS_EVENTS_TOPIC=sos.events
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SSL_TRUSTSTORE_TYPE=PEM
KAFKA_SSL_TRUSTSTORE_CERTIFICATES=

# Security & Authentication (JWT)
JWT_SECRET=replace_with_a_secure_random_base64_encoded_key_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

# Maps & Location External APIs
MAPS_API_KEY=
MAPS_PROVIDER=google
MAPS_CONNECT_TIMEOUT=3000
LOCATION_RADIUS_KM=2.0
DISCOVERY_INTERVAL_MS=15000

# File Upload Configuration
UPLOAD_DIR=/app/uploads

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin Bootstrap Configuration (Optional)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_MOBILE=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=System Administrator

# Firebase Cloud Messaging (FCM) Credentials Path
# Mount your local Firebase service account key JSON into the container and set this path:
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json

# Environment Policy & Firebase Strict Mode
# In development (dev), missing Firebase credentials log a warning and use simulation mode.
# In production (prod / production / strict), valid credentials or ADC are required and missing credentials will fail startup.
SPRING_PROFILES_ACTIVE=dev
ENVIRONMENT=development
FIREBASE_STRICT=false

# Server & Host Port Bindings (Defaults to 127.0.0.1 loopback for secure deployment)
SERVER_PORT=8080
BACKEND_HOST_PORT=127.0.0.1:8080
MYSQL_HOST_PORT=127.0.0.1:3307
REDIS_HOST_PORT=127.0.0.1:6379
KAFKA_HOST_PORT=127.0.0.1:9092
